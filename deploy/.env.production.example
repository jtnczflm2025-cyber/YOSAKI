# Copy this file to .env.production and replace every value marked CHANGE_ME.
YOSAKI_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN
YOSAKI_COOKIE_SECURE=1
# Keep this stable across restarts. Generate a Fernet key; do not commit it.
YOSAKI_SECRET_KEY=CHANGE_ME_FERNET_KEY
# Optional scheduled encrypted backups. Keep values on the server, outside Git.
# YOSAKI_BACKUP_PASSWORD=CHANGE_ME_12_OR_MORE_CHARACTERS
# YOSAKI_BACKUP_GITHUB_TOKEN=CHANGE_ME_DEDICATED_PRIVATE_REPO_TOKEN
# Optional local-only ChatGPT plan OAuth experiment. Keep off on public/VPS hosts.
# YOSAKI_CHATGPT_PLAN_ENABLED=1
